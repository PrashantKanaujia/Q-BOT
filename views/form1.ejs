<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Form</title>
    <link rel="stylesheet" href="/stylesheets/fstyle.css">
</head>
<body>
    <div class="login-container">
        <h1>IMSEC GHAZIABAD</h1>
        <form action="/home" method="POST" id="loginform">
            <label for="email" style="color: rgb(178, 174, 174);">USER ID:</label>
            <input type="number" id="email" name="email" min="1" max="20" placeholder="1 to 20" required>

            <label for="password" style="color: rgb(178, 174, 174);">Password:</label>
            <input type="password" id="password" name="password" placeholder="0<User ID>0" required>

            <button type="submit">Login</button>
        </form>
    </div>
</body>
</html>
